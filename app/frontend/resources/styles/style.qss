/* Estilos globales de la aplicación PyQt */

QMainWindow {
    background-color: #f5f5f5;
}

QLabel {
    color: #333333;
}

QPushButton {
    background-color: #0078d4;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #005a9e;
}

QPushButton:pressed {
    background-color: #004578;
}

QTableWidget {
    border: 1px solid #cccccc;
    gridline-color: #e0e0e0;
    background-color: white;
    alternate-background-color: #f9f9f9;
}

QHeaderView::section {
    background-color: #0078d4;
    color: white;
    padding: 6px;
    border: none;
    font-weight: bold;
}
